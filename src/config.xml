<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://arn0.tv/launcher" version="0.6.12" viewmodes="maximized">
    <!-- package must be exactly 10 alphanumeric characters -->
    <!-- KEEP THIS APPLICATION ID STABLE: the TV's Home-button mapping targets it directly.
         Changing it can leave Home pointing to an app ID that is no longer installed. -->
    <tizen:application id="Arn0Lnchr0.Launcher" package="Arn0Lnchr0" required_version="3.0"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>Arn0 Launcher</name>

    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>

    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/application.info"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <!-- Open-Meteo request for the screen saver (js/config.js → weather) and the development log -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <access origin="*" subdomains="true"/>

    <!-- Lets the TV start the app in the background at power-on so opening it is faster -->
    <tizen:metadata key="http://samsung.com/tv/metadata/prelaunch.support" value="true"/>

    <tizen:profile name="tv-samsung"/>
    <!-- background-support: without it the TV ends the launcher as soon as another app is in front
         (seen on a UE50NU7025), and "Return here after an app" has nobody left to bring back.
         Hidden, the launcher stops its clock, rotation and audio, so the app in front pays nothing. -->
    <tizen:setting screen-orientation="landscape" context-menu="disable"
                   background-support="enable" encryption="disable"
                   install-location="auto" hwkey-event="enable"/>
</widget>
